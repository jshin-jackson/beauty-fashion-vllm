# ============================================================
# 로컬 환경 설정 (local-m2pro 브랜치)
# ============================================================
# 사용 방법: cp .env.local.example .env
# ============================================================

# vLLM 서버 주소 (start_vllm.sh 로 로컬에서 시작)
VLLM_BASE_URL=http://localhost:8000/v1

# 모델 이름 — M2 Pro CPU 모드에 적합한 소형 모델
# 더 작은 모델: Qwen/Qwen2.5-1.5B-Instruct (빠르지만 품질 낮음)
# 더 큰 모델:   Qwen/Qwen2.5-7B-Instruct  (느리지만 품질 높음, RAM 16GB 이상 필요)
MODEL_NAME=Qwen/Qwen2.5-3B-Instruct

# vLLM 실행 장치
DEVICE=cpu

# 숫자 정밀도 (CPU는 float32 사용)
DTYPE=float32

# 최대 컨텍스트 길이 (CPU 메모리 절약을 위해 짧게 설정)
MAX_MODEL_LEN=4096

# vLLM 서버 포트
VLLM_PORT=8000

# FastAPI 앱 포트 (로컬은 8080 사용)
APP_PORT=8080

# 최대 응답 토큰 수
MAX_TOKENS=300

# 창의성 조절 (0.0 ~ 1.5)
TEMPERATURE=0.7

# 시스템 프롬프트 (변경하고 싶으면 여기서 수정)
SYSTEM_PROMPT=너는 10년 경력의 청담동 패션 스타일리스트야. 친근한 말투로 트렌디한 브랜드를 섞어서 추천해 줘. 답변은 3~5문장으로 간결하게 해줘.
