# ============================================================
# 로컬 환경 설정 (local-m2pro 브랜치)
# ============================================================
# 사용 방법: cp .env.local.example .env
#
# vLLM 설치 전에 scripts/install_vllm_local.sh 를 먼저 실행하세요.
# ============================================================

# vLLM 서버 주소 (start_vllm.sh 로 로컬에서 시작)
VLLM_BASE_URL=http://localhost:8000/v1

# 모델 이름 — HuggingFace Hub 모델 ID
# 1.5B (기본값, ~6GB): Qwen/Qwen2.5-1.5B-Instruct  ← M2 Pro 32GB 권장
# 3B   (~12GB):        Qwen/Qwen2.5-3B-Instruct      ← 여유 RAM 16GB+ 필요
# 7B   (~28GB):        Qwen/Qwen2.5-7B-Instruct      ← 여유 RAM 많을 때
MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct

# 숫자 정밀도 (CPU 모드에서는 float32)
DTYPE=float32

# 최대 컨텍스트 길이 (RAM 절약을 위해 4096으로 제한)
MAX_MODEL_LEN=4096

# vLLM 서버 포트
VLLM_PORT=8000

# CPU 백엔드의 RAM 예약 비율 (이름은 gpu이지만 CPU에서 RAM을 의미)
# 전체 RAM × 이 값 = 예약할 메모리
# 예: 32GB × 0.3 = 9.6GB (1.5B 모델에 충분)
# 예: 32GB × 0.5 = 16GB  (3B 모델에 적합, 여유 RAM 16GB+ 필요)
GPU_MEMORY_UTILIZATION=0.3

# FastAPI 앱 포트
APP_PORT=8080

# 최대 응답 토큰 수
MAX_TOKENS=300

# 창의성 조절 (0.0 ~ 1.5)
TEMPERATURE=0.7

# 시스템 프롬프트
SYSTEM_PROMPT=너는 10년 경력의 청담동 패션 스타일리스트야. 친근한 말투로 트렌디한 브랜드를 섞어서 추천해 줘. 답변은 3~5문장으로 간결하게 해줘.
