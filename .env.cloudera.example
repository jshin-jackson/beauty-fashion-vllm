# Cloudera AI 환경 설정
# Session에서 수동 실행 시: cp .env.cloudera.example .env 후 source 또는 export

# vLLM 서버 주소 (같은 Session/Application 컨테이너 내부)
VLLM_BASE_URL=http://127.0.0.1:8001/v1

# CPU 8GiB 환경에 맞는 소형 모델
MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct

# vLLM 서버 파라미터
MAX_MODEL_LEN=2048
VLLM_PORT=8001
GPU_MEMORY_UTILIZATION=0.35
MAX_NUM_SEQS=1

# FastAPI 앱 포트
APP_PORT=8002

MAX_TOKENS=300
TEMPERATURE=0.7

SYSTEM_PROMPT=너는 10년 경력의 청담동 패션 스타일리스트야. 친근한 말투로 트렌디한 브랜드를 섞어서 추천해 줘. 답변은 3~5문장으로 간결하게 해줘.
